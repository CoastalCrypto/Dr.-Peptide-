# PepTrack Pro — Backend Environment Variables
# Copy this file to .env and fill in your values

# MongoDB connection string
# Local: mongodb://localhost:27017
# Atlas: mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGO_URL=mongodb://localhost:27017

# Database name
DB_NAME=peptrack_db

# Emergent AI integration (for AI-powered research features)
# Get this from your Emergent.sh project settings
EMERGENT_LLM_KEY=

# Server port (optional, defaults to 8000)
PORT=8000
